# ---- required -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
QUOTE_NOTIFY_EMAIL=you@yourcompany.com          # where quote requests land
PUBLIC_URL=https://quotes.yourcompany.com       # this server's public URL

# ---- who may embed the widget --------------------------------------------
ALLOWED_ORIGINS=https://www.yourcompany.com,https://yourcompany.com

# ---- branding -------------------------------------------------------------
BRAND_NAME=Your Workshop
BRAND_ACCENT=#FF6A1A

# ---- email ---------------------------------------------------------------
# Option A: Resend (simplest — one API key, no SMTP config)
RESEND_API_KEY=re_...
MAIL_FROM=Quotes <quotes@yourcompany.com>
# Option B: any SMTP provider instead of Resend
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SEND_CUSTOMER_COPY=true

# ---- file storage --------------------------------------------------------
# local: files live in DATA_DIR (needs a persistent volume)
STORAGE_DRIVER=local
DATA_DIR=./data
# s3: any S3-compatible bucket (Cloudflare R2 shown)
# STORAGE_DRIVER=s3
# S3_BUCKET=cad-quote-files
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://files.yourcompany.com   # omit to use signed URLs

# ---- model + render tuning ------------------------------------------------
ANTHROPIC_MODEL=claude-opus-5
OPENSCAD_BIN=openscad
OPENSCAD_XVFB=true            # set false on macOS/desktop where GL is available
OPENSCAD_TIMEOUT_MS=90000

# ---- abuse limits ---------------------------------------------------------
MAX_SESSIONS_PER_IP_HOUR=12
MAX_MESSAGES_PER_IP_HOUR=200
MAX_GENERATIONS_PER_SESSION=6
SESSION_TTL_HOURS=72
