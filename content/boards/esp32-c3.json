  "logic_volts": 3.3,
  "wifi": true,
  "bluetooth": true,
  "optional": true,
  "order": 7,
  "notes": "A very small, cheap WiFi board with built-in USB. It runs on 3.3V. (USB CDC on boot is on, so the Serial Monitor works over its USB port.)",
