# Optional. Without a key the game still runs — it falls back to the built-in
# fuzzy matcher (typos, plurals, word order and every alias in the clue bank
# are handled locally). The API key only adds judgement for phrasings nobody
# anticipated, e.g. "the lady who asked how the mind pushes the body".
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# PORT=3000
# HOST_TOKEN=...      # forces the host/projector gate on locally too
# JOIN_CODE=MIND      # forces the team join code on locally too
