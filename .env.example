# Copy this file to .env and change the values.
# Every setting can also be supplied as a normal environment variable (e.g. on Render or Azure).

PORT=3000
DATA_DIR=./data
TIMEZONE=Australia/Melbourne

# Password for /admin. CHANGE THIS before putting the site online.
ADMIN_PASSWORD=change-me

# Secret part of the Outlook calendar-feed URLs. Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CALENDAR_FEED_TOKEN=change-me-to-a-long-random-string

# How bookings reach Microsoft 365:  none | email | graph | webhook   (see README → "Microsoft Bookings")
SYNC_MODE=none

# true = shows the demo banner and the "Reset demo data" button, and seeds demo data on first start
DEMO_MODE=true

# ---- email mode -----------------------------------------------------------
# Leave SMTP_HOST empty to write invites to data/outbox/*.eml instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# comma-separated, e.g. the Bookings calendar mailbox and/or staff
INVITE_ADDRESSES=

# ---- graph mode (needs an app registration from IT) ------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
BOOKINGS_BUSINESS_ID=

# ---- advanced (optional) ---------------------------------------------------
# Public address of the site, used in links inside calendar invites, e.g. https://bookings.example.org
PUBLIC_URL=
# Path to the rules file (default: config/catalog.yaml)
CATALOG_PATH=
# Only for testing graph mode against the local mock server (npm run graph:mock):
# GRAPH_BASE_URL=http://localhost:4010/v1.0

# ---- Power Automate (see docs/POWER-AUTOMATE-SETUP.md) ----------------------
# SYNC_MODE=webhook sends every booking/cancellation to this flow URL
# (the "HTTP POST URL" of a flow that starts with "When an HTTP request is received").
POWER_AUTOMATE_WEBHOOK_URL=
# Secret that flows must send when telling the site about Microsoft Bookings appointments
# (POST /api/integrations/power-automate). Leave empty to switch that endpoint off.
INBOUND_WEBHOOK_SECRET=
