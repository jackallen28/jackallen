# Optional. Without a key the game still runs — it falls back to a built-in
# fuzzy matcher (typos, plurals, word order and every alias in the question
# bank are handled locally). The API key only adds judgement for phrasings
# nobody anticipated, e.g. "the thing where the hand isn't yours".
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# PORT=3000
