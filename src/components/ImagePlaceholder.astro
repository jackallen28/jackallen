---
interface Props {
  label: string;
  ratio?: string;
  class?: string;
}

const { label, ratio = 'aspect-[4/3]', class: className = '' } = Astro.props;
---

<div
  class={`${ratio} w-full overflow-hidden rounded-lg border border-line bg-[linear-gradient(135deg,#efeee9_25%,transparent_25%,transparent_50%,#efeee9_50%,#efeee9_75%,transparent_75%,transparent)] bg-[length:14px_14px] ${className}`}
  role="img"
  aria-label={`Image placeholder: ${label}`}
>
  <div class="flex h-full w-full items-center justify-center p-6 text-center">
    <span class="rounded-full bg-paper/90 px-4 py-1.5 text-xs font-medium tracking-tight text-ink-soft shadow-sm">
      {label}
    </span>
  </div>
</div>
