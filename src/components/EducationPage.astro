---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';

interface Block {
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  number: string;
  label: string;
  heading: string;
  intro: string;
  blocks: Block[];
  ctaLabel: string;
  heroImage: string;
}

const { title, description, number, label, heading, intro, blocks, ctaLabel, heroImage } = Astro.props;
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-4xl px-6 pb-16 pt-20 sm:pt-28">
    <SectionLabel number={number} label={label} class="reveal" />
    <h1 class="reveal mt-6 text-balance text-4xl font-semibold leading-[1.05] tracking-tightest sm:text-5xl">
      {heading}
    </h1>
    <p class="reveal mt-6 max-w-2xl text-balance text-base leading-relaxed text-ink-soft sm:text-lg">
      {intro}
    </p>
  </section>

  <section class="reveal border-t border-line">
    <div class="mx-auto max-w-6xl px-6 py-4">
      <ImagePlaceholder label={heroImage} ratio="aspect-[21/9]" />
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl divide-y divide-line px-6">
      {
        blocks.map((block, i) => (
          <div class="reveal grid gap-6 py-14 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-16">
            <span class="text-xs font-medium uppercase tracking-[0.14em] text-ink-soft">
              {`0${i + 1}`}
            </span>
            <div>
              <h2 class="text-2xl font-semibold tracking-tight">{block.title}</h2>
              <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-soft">{block.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-line">
    <div class="reveal mx-auto max-w-3xl px-6 py-24 text-center">
      <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
        Bring this to your school.
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-ink-soft">
        Tell us about your students, your curriculum focus and your timeline.
      </p>
      <div class="mt-8 flex justify-center">
        <Button href="/contact/">{ctaLabel}</Button>
      </div>
    </div>
  </section>
</Layout>
