# Copy to .env and fill in before class.

# Your Anthropic API key. Without it the AI partner falls back to simple
# scripted replies, so the activity still runs but is much easier to spot.
ANTHROPIC_API_KEY=sk-ant-...

# Passcode for the /teacher console. Change this.
TEACHER_PASSCODE=change-me

# Port to listen on.
PORT=3000

# Optional: the model used when a round does not specify one. Models are normally
# chosen in the teacher console instead, which can also mix several per round.
# BOT_MODEL=claude-haiku-4-5

# Optional: replace the bot's persona instructions entirely.
# BOT_PERSONA=You are pretending to be a Year 10 student...
