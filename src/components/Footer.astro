---
import { nav, site } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-[1.3fr_1fr_1fr]">
      <div>
        <p class="text-base font-semibold tracking-tight text-ink">Allentronics</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-soft">
          Education studio led by Jack Allen — AI, design thinking and fabrication in the
          classroom, backed by a working manufacturing business.
        </p>
      </div>

      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-ink-soft">Navigate</p>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-ink-soft transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-ink-soft">Contact</p>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm text-ink-soft">
          <li><a href={`mailto:${site.email}`} class="transition-colors hover:text-ink">{site.email}</a></li>
          <li><a href={site.phoneHref} class="transition-colors hover:text-ink">{site.phone}</a></li>
          <li>{site.domain}</li>
        </ul>
        <div class="mt-5 flex gap-4">
          {
            site.socials.map((s) => (
              <a href={s.href} class="text-sm text-ink-soft transition-colors hover:text-ink" target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-line pt-6 text-xs text-ink-soft sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Allentronics. All rights reserved.</p>
      <p>Melbourne, Australia</p>
    </div>
  </div>
</footer>
