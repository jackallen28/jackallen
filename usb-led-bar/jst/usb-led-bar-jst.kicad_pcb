  (footprint "usb-led-bar:LED_2835_PolarityTolerant" (layer "F.Cu")
    (tstamp 04bd56e4-1e2d-4002-a298-779154764a62)
    (at 162.5 107.5 90)
    (descr "2835 (3.5 x 2.8 mm) mid-power LED, as used on LED strips. 2835 makers disagree on whether the large bottom pad is the anode or the cathode, so the copper pads are symmetric with their inner edges 2.1 mm apart: whichever end the large pad is on, it lands on one pad only and the small pad lands on the other. Polarity is then set purely by placement rotation (cathode = bar end of the silkscreen). Pad 1 = K, pad 2 = A.")
    (tags "LED 2835 PLCC-2 strip polarity")
    (property "LCSC" "C2843875")
    (property "MPN" "XL-2835WWC-02")
