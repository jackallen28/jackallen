(footprint "LED_2835_PolarityTolerant" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "2835 (3.5 x 2.8 mm) mid-power LED, as used on LED strips. 2835 makers disagree on whether the large bottom pad is the anode or the cathode, so the copper pads are symmetric with their inner edges 2.1 mm apart: whichever end the large pad is on, it lands on one pad only and the small pad lands on the other. Polarity is then set purely by placement rotation (cathode = bar end of the silkscreen). Pad 1 = K, pad 2 = A.")
  (tags "LED 2835 PLCC-2 strip polarity")
  (attr smd)
  (fp_text reference "REF**" (at 0 -2.6) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.16)))
  )
  (fp_text value "LED_2835_PolarityTolerant" (at 0 2.7) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_line (start -2.65 -1.65) (end 2.3 -1.65) (stroke (width 0.16) (type solid)) (layer "F.SilkS"))
  (fp_line (start -2.65 1.65) (end 2.3 1.65) (stroke (width 0.16) (type solid)) (layer "F.SilkS"))
  (fp_line (start -2.65 -1.65) (end -2.65 1.65) (stroke (width 0.3) (type solid)) (layer "F.SilkS"))
  (fp_line (start -1.1 -1.4) (end 1.75 -1.4) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 1.75 -1.4) (end 1.75 1.4) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 1.75 1.4) (end -1.75 1.4) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -1.75 1.4) (end -1.75 -0.75) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -1.75 -0.75) (end -1.1 -1.4) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -2.95 -1.95) (end 2.55 -1.95) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 2.55 -1.95) (end 2.55 1.95) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 2.55 1.95) (end -2.95 1.95) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -2.95 1.95) (end -2.95 -1.95) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (pad "1" smd roundrect (at -1.65 0) (size 1.2 2.4) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.1))
  (pad "2" smd roundrect (at 1.65 0) (size 1.2 2.4) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.1))
  (model "${KICAD6_3DMODEL_DIR}/LED_SMD.3dshapes/LED_PLCC_2835.wrl"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
