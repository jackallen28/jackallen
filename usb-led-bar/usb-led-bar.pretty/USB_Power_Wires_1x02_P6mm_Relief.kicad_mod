(footprint "USB_Power_Wires_1x02_P6mm_Relief" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Solder pads for the +5V and GND wires of a cut USB cable, with feed-through strain-relief holes. Pad drill 1.0 mm (conductors up to 20 AWG), relief hole 1.8 mm (insulated wire up to ~1.7 mm OD). Thread each wire down through its relief hole, back up through its pad from the bottom, then solder on top.")
  (tags "USB power wire solder pad strain relief")
  (attr through_hole exclude_from_pos_files exclude_from_bom)
  (fp_text reference "REF**" (at -2.5 0 90) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "USB_Power_Wires_1x02_P6mm_Relief" (at -2.5 5.4) (layer "F.Fab") hide
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -6.25 -4.45) (end 1.45 -4.45) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 1.45 -4.45) (end 1.45 4.45) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 1.45 4.45) (end -6.25 4.45) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -6.25 4.45) (end -6.25 -4.45) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -5 -3) (end 0 -3) (stroke (width 0.1) (type dash)) (layer "F.Fab"))
  (fp_line (start -5 3) (end 0 3) (stroke (width 0.1) (type dash)) (layer "F.Fab"))
  (pad "" np_thru_hole circle (at -5 -3) (size 1.8 1.8) (drill 1.8) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -5 3) (size 1.8 1.8) (drill 1.8) (layers "*.Cu" "*.Mask"))
  (pad "1" thru_hole roundrect (at 0 -3) (size 2.2 2.2) (drill 1) (layers "*.Cu" "*.Mask") (roundrect_rratio 0.15))
  (pad "2" thru_hole circle (at 0 3) (size 2.2 2.2) (drill 1) (layers "*.Cu" "*.Mask"))
)
