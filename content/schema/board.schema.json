{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board.schema.json",
  "title": "CircuitPath board",
  "description": "One board students can pick. The file name must be <id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "short", "family", "fqbn", "logic_volts", "wifi", "upload", "order"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "short": { "description": "A short name for the toolbar.", "type": "string", "minLength": 1, "maxLength": 20 },
    "family": { "enum": ["avr", "esp8266", "esp32"] },
    "fqbn": { "description": "The arduino-cli board name.", "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+:[a-z0-9_]+(:[a-zA-Z0-9_=,]+)?$" },
    "logic_volts": { "enum": [5, 3.3] },
    "wifi": { "type": "boolean" },
    "bluetooth": { "type": "boolean" },
    "optional": { "description": "Hidden unless the Teacher page turns it on.", "type": "boolean" },
    "default": { "description": "The board picked for new profiles. Exactly one board has this.", "type": "boolean" },
    "order": { "type": "integer", "minimum": 0 },
    "notes": { "type": "string", "maxLength": 300 },
    "upload": { "$ref": "#/$defs/upload" },
    "variants": {
      "description": "Other settings for the same board, such as the old bootloader on Nano clones.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "fqbn", "upload"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "fqbn": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+:[a-z0-9_]+(:[a-zA-Z0-9_=,]+)?$" },
          "upload": { "$ref": "#/$defs/upload" }
        }
      }
    }
  },
  "$defs": {
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "baud"],
      "properties": {
        "protocol": { "enum": ["stk500v1", "stk500v2", "esptool", "uno-r4"] },
        "baud": { "type": "integer", "enum": [57600, 115200, 230400, 460800, 921600] }
      }
    }
  }
}
