# Copy to .env and fill in before running the activity.

# Your Anthropic API key. Without it the AI partner falls back to scripted replies
# and cross-language messages are delivered untranslated.
ANTHROPIC_API_KEY=sk-ant-...

# Passcode for the /teacher console. Change this.
TEACHER_PASSCODE=change-me

# Port to listen on.
PORT=3000

# The public address, when hosted. Render sets RENDER_EXTERNAL_URL itself.
# PUBLIC_URL=https://your-app.onrender.com

# Optional: first names that the bot must never generate, comma separated.
# CLASS_BLOCKLIST=Wei,Chen,Sam

# Optional: the model used when a round does not specify one.
# BOT_MODEL=claude-haiku-4-5

# Optional: the model used to translate messages between participants.
# TRANSLATE_MODEL=claude-haiku-4-5

# Optional reply pacing. Defaults give at least 4s of thinking, then 5-60 wpm.
# BOT_THINK_MS=4000
# BOT_WPM_MIN=5
# BOT_WPM_MAX=60
# BOT_REPLY_CAP_MS=30000
