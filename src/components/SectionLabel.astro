---
interface Props {
  number: string;
  label: string;
  class?: string;
}

const { number, label, class: className = '' } = Astro.props;
---

<div class={`flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-ink-soft ${className}`}>
  <span class="text-accent">{number}</span>
  <span class="h-px w-8 bg-line"></span>
  <span>{label}</span>
</div>
